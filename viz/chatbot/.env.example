# Copy to viz/chatbot/.env and fill in. Never commit the filled file.

# Chat key. Required to answer questions.
XAI_API_KEY=

# Management key with AddFileToCollection (and collection-create, if you use --create).
# Used only by build_collection.py.
XAI_MANAGEMENT_API_KEY=

# Id printed by build_collection.py. Pins the collection the API searches.
XAI_COLLECTION_ID=

# Reasoning model. grok-4.7 is the default (xAI flagship with configurable reasoning,
# checked against docs on 3 November 2026). Override here if the team standardises on another id.
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=high
XAI_TIMEOUT_SECONDS=180

# Leave blank to use viz/chatbot/collection_pin.json.
FISHCAST_COLLECTION_VERSION=

# Off by default so answers stay on the FishCast collection.
CHATBOT_ENABLE_WEB_SEARCH=false
CHATBOT_SEARCH_LIMIT=8

# Leave the password blank to disable auth. If the password is set and the user is blank,
# the user name is fishcast.
CHATBOT_BASIC_AUTH_USER=
CHATBOT_BASIC_AUTH_PASSWORD=
CHATBOT_RATE_LIMIT_PER_MINUTE=30
CHATBOT_AUDIT_LOG=viz/chatbot/audit/audit.jsonl

# Streamlit only.
CHATBOT_API_URL=http://localhost:8000
